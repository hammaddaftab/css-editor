{
  "name": "css-editor-frontend",
  "version": "1.0.0",
  "description": "CSS Markdown Editor frontend — built with Vite, React, TypeScript, and CodeMirror 6",
  "type": "module",
  "scripts": {
    "build": "npx vite build",
    "dev": "npx vite build --watch",
    "preview": "npx vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.2.1",
    "@codemirror/lang-markdown": "^6.2.4",
    "@codemirror/state": "^6.4.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.28.0",
    "codemirror": "^6.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^5.4.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
