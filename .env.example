# Copy to .env and customise
# All vars use the EDITOR_ prefix

# Optional: watch a markdown file on disk and push live updates to all browsers
# EDITOR_WATCH_FILE=/path/to/my-document.md

# Enable FastAPI debug mode
# EDITOR_DEBUG=true

# Directories to include for watching and editing (comma-separated, relative to root)
# "." represents the workspace root
# EDITOR_INCLUDE_PATHS=[dsa-1]
